using "ui/basic.style";
using "ui/widgets/widgets.style";
using "ui/chat/chat.style";
using "info/info.style";

topBarMemo: IconButton(topBarSearch) {
	icon: icon {{ "menu/saved_messages", menuIconFg }};
	iconOver: icon {{ "menu/saved_messages", menuIconFgOver }};
}
topBarMemoActive: icon {{ "menu/saved_messages", windowActiveTextFg }};

memoTabs: SubTabs(defaultSubTabs) {
	bg: windowBg;
}

memoComposeControls: ComposeControls(repliesComposeControls) {
}
