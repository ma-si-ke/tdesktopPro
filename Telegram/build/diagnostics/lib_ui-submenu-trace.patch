+[[nodiscard]] QString TracePtr(const void *pointer) {
+	return QString::number(reinterpret_cast<quintptr>(pointer), 16);
+}
+
+[[nodiscard]] QString TraceRect(QRect rect) {
+	return QStringLiteral("%1,%2 %3x%4"
+	).arg(rect.x()).arg(rect.y()).arg(rect.width()).arg(rect.height());
+}
+
+[[nodiscard]] QString TracePoint(QPoint point) {
+	return QStringLiteral("%1,%2").arg(point.x()).arg(point.y());
+}
+
+[[nodiscard]] QString TraceWidget(const QWidget *widget) {
+	if (!widget) {
+		return QStringLiteral("null");
+	}
+	return QStringLiteral("%1(%2 vis=%3 hidden=%4 geom=%5)"
+	).arg(QString::fromLatin1(widget->metaObject()->className())
+	).arg(TracePtr(widget)
+	).arg(widget->isVisible() ? 1 : 0
+	).arg(widget->isHidden() ? 1 : 0
+	).arg(TraceRect(widget->geometry()));
+}
+
+[[nodiscard]] QString TraceAction(const QAction *action) {
+	return action
+		? (TracePtr(action)
+			+ QStringLiteral(" \"")
+			+ action->text()
+			+ QStringLiteral("\""))
+		: QStringLiteral("null");
+}
+
+[[nodiscard]] QString TraceSource(Menu::TriggeredSource source) {
+	return (source == Menu::TriggeredSource::Mouse)
+		? QStringLiteral("mouse")
+		: QStringLiteral("keyboard");
+}
+
+[[nodiscard]] QString TraceWindow(const QWindow *window) {
+	if (!window) {
+		return QStringLiteral("null");
+	}
+	const auto widget = QWidget::find(window->winId());
+	return QStringLiteral("%1(%2 type=%3 vis=%4)"
+	).arg(TracePtr(window)
+	).arg(widget
+		? QString::fromLatin1(widget->metaObject()->className())
+		: QStringLiteral("?")
+	).arg(int(window->type())
+	).arg(window->isVisible() ? 1 : 0);
+}
+
+#ifdef Q_OS_WIN
+[[nodiscard]] QString TraceHwnd(HWND hwnd) {
+	if (!hwnd) {
+		return QStringLiteral("0");
+	}
+	const auto widget = QWidget::find(reinterpret_cast<WId>(hwnd));
+	return QStringLiteral("%1(%2)"
+	).arg(TracePtr(hwnd)
+	).arg(widget
+		? QString::fromLatin1(widget->metaObject()->className())
+		: QStringLiteral("?"));
+}
+
+[[nodiscard]] QString TraceNativeState() {
+	return QStringLiteral("focus=%1 active=%2 foreground=%3 capture=%4"
+	).arg(TraceHwnd(GetFocus())
+	).arg(TraceHwnd(GetActiveWindow())
+	).arg(TraceHwnd(GetForegroundWindow())
+	).arg(TraceHwnd(GetCapture()));
+}
+
+[[nodiscard]] const char *TraceNativeName(UINT message) {
+	switch (message) {
+	case WM_MOUSEACTIVATE: return "WM_MOUSEACTIVATE";
+	case WM_SETFOCUS: return "WM_SETFOCUS";
+	case WM_KILLFOCUS: return "WM_KILLFOCUS";
+	case WM_ACTIVATE: return "WM_ACTIVATE";
+	case WM_NCACTIVATE: return "WM_NCACTIVATE";
+	case WM_ACTIVATEAPP: return "WM_ACTIVATEAPP";
+	case WM_CAPTURECHANGED: return "WM_CAPTURECHANGED";
+	case WM_LBUTTONDOWN: return "WM_LBUTTONDOWN";
+	case WM_LBUTTONUP: return "WM_LBUTTONUP";
+	case WM_RBUTTONDOWN: return "WM_RBUTTONDOWN";
+	case WM_NCLBUTTONDOWN: return "WM_NCLBUTTONDOWN";
+	case WM_CANCELMODE: return "WM_CANCELMODE";
+	case WM_WINDOWPOSCHANGED: return "WM_WINDOWPOSCHANGED";
+	case WM_SHOWWINDOW: return "WM_SHOWWINDOW";
+	}
+	return nullptr;
+}
+
+class TraceNativeFilter final : public QAbstractNativeEventFilter {
+public:
+	bool nativeEventFilter(
+			const QByteArray &,
+			void *message,
+			native_event_filter_result *) override {
+		const auto popup = QApplication::activePopupWidget();
+		if (!popup) {
+			return false;
+		}
+		const auto msg = static_cast<MSG*>(message);
+		const auto name = TraceNativeName(msg->message);
+		if (!name) {
+			return false;
+		}
+		LOG((QStringLiteral("SubmenuTrace: native %1 hwnd=%2 wParam=%3 "
+			"wParamHwnd=%4 lParam=%5 lParamHwnd=%6 %7 activePopup=%8"
+		).arg(QString::fromLatin1(name)
+		).arg(TraceHwnd(msg->hwnd)
+		).arg(qulonglong(msg->wParam)
+		).arg(TraceHwnd(reinterpret_cast<HWND>(msg->wParam))
+		).arg(qlonglong(msg->lParam)
+		).arg(TraceHwnd(reinterpret_cast<HWND>(msg->lParam))
+		).arg(TraceNativeState()
+		).arg(TracePtr(popup))));
+		return false;
+	}
+};
+#else // Q_OS_WIN
+[[nodiscard]] QString TraceNativeState() {
+	return QString();
+}
+#endif // Q_OS_WIN
+
+void InstallTraceHooksOnce() {
+	static const auto installed = [] {
+#ifdef Q_OS_WIN
+		QCoreApplication::instance()->installNativeEventFilter(
+			new TraceNativeFilter());
+#endif // Q_OS_WIN
+		QObject::connect(
+			qApp,
+			&QGuiApplication::focusWindowChanged,
+			[](QWindow *window) {
+				LOG((QStringLiteral("SubmenuTrace: focusWindowChanged %1 "
+					"activePopup=%2 %3"
+				).arg(TraceWindow(window)
+				).arg(TracePtr(QApplication::activePopupWidget())
+				).arg(TraceNativeState())));
+			});
+		QObject::connect(
+			qApp,
+			&QApplication::focusChanged,
+			[](QWidget *was, QWidget *now) {
+				LOG((QStringLiteral("SubmenuTrace: focusChanged %1 -> %2 "
+					"activePopup=%3"
+				).arg(TraceWidget(was)
+				).arg(TraceWidget(now)
+				).arg(TracePtr(QApplication::activePopupWidget()))));
+			});
+		return true;
+	}();
+	Q_UNUSED(installed);
+}
